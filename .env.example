# Appendix A environment. Values are set in .env (never committed) from KEYS.md.
# Not read by the dispatcher; never passed to sessions.
ANTHROPIC_API_KEY=
ANTHROPIC_ORG_ID=
AGENT_MODE=attended
# Unattended mode only. The studio organisation's key; mapped to ANTHROPIC_API_KEY inside agent sessions and nowhere else. Never the founder's key.
STUDIO_ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Supabase's publishable and secret key pair, issued alongside the anon and service-role keys.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase Management API token; ops only.
SUPABASE_ACCESS_TOKEN=
# Direct database password; unused by the code.
SUPABASE_DB_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID_SEED=
NETLIFY_SITE_ID_PLATFORM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=
BOARD_EMAILS=
MODERATOR_EMAIL=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
POOL_DAILY_CAP_USD=100
CARD_MAX_USD=25
SESSION_MAX_TURNS=60
AGENT_HOURLY_RATE_USD=5
MODEL_BUILDER=
MODEL_DIRECTOR=
MODEL_HOST=
PRICE_TABLE_JSON=

# Site build-time values (public; set per Netlify site).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PAYMENT_LINK_URL=
VITE_DISCORD_INVITE=
# Launch timestamp for the site; empty and unused for now.
VITE_LAUNCH_AT=
# Where the site's Play link goes.
VITE_PLAY_URL=

# Dispatcher additions beyond Appendix A.
DISPATCHER_TICK_MS=60000
DISPATCHER_WORKTREE_ROOT=
DISPATCHER_MAX_CONCURRENCY=1
DISPATCHER_SCHEDULER=on
CLAUDE_BIN=claude
BOARD_SESSION_TTL_MIN=3

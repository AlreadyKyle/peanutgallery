# Environment for the dispatcher, the Supabase seed and scripts, and the ops scripts (PLAN.md
# Appendix A). Values go in .env at the repository root, which is never committed, from the local
# KEYS.md, which is never committed either. Keys marked "reserved, not read yet" are for features
# that do not exist; no code reads them.

# The founder's key. The dispatcher reads it only to refuse a STUDIO_ANTHROPIC_API_KEY equal to it,
# never passes it to an agent session, and make-dispatcher-env.sh never copies it to the VPS.
ANTHROPIC_API_KEY=
# Reserved, not read yet.
ANTHROPIC_ORG_ID=
AGENT_MODE=attended
# Unattended mode only. The studio organisation's key. Only the dispatcher's Managed Agents client
# reads it: sessions run in containers Anthropic hosts and never see it. Never the founder's key.
# `pnpm --filter @backseat/dispatcher managed:apply` uses it too, and refuses the founder's.
STUDIO_ANTHROPIC_API_KEY=
# Unattended mode only (docs/specs/launch-managed.md). The Managed Agents agent every writing role
# runs as, the agent version the dispatcher pins, and the environment card sessions run in, as
# `managed:apply` prints them. They are ids, not secrets: make-dispatcher-env.sh copies them from this
# file to the VPS env file.
MANAGED_AGENT_ID=
MANAGED_AGENT_VERSION=
MANAGED_ENVIRONMENT_ID=
# Unattended mode only. A fine-grained token for this repository with Contents read and nothing else;
# Managed Agents sessions clone with it. The dispatcher refuses it when it equals GITHUB_TOKEN and
# unless GitHub denies it a write. On the VPS it comes from the operator's exported shell
# (make-dispatcher-env.sh), not from this file; here it is for `managed:apply -- --check`.
GITHUB_READ_TOKEN=
SUPABASE_URL=
# The dispatcher and the seed read this. make-dispatcher-env.sh and sign-synthetic-event.ts use
# SUPABASE_SECRET_KEY instead when it is set.
SUPABASE_SERVICE_ROLE_KEY=
# Read by scripts/anon-negative-test.ts.
SUPABASE_ANON_KEY=
# Reserved, not read yet.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase Management API token. No code reads it; provision.sh refuses it in the VPS env file.
SUPABASE_ACCESS_TOKEN=
# Direct database password, the owner's. Reserved, not read yet: on the Mac only, for a by-hand step
# such as the one-time migration history repair. provision.sh refuses it in the VPS env file, and no
# VPS job accepts a login as the owner.
SUPABASE_DB_PASSWORD=
# The dispatcher's GitHub token: a fine-grained token (github_pat_...) for this repository alone,
# with Contents and Pull requests read and write and Checks read (docs/BOARD-SETUP.md). Unattended
# mode refuses any other kind and attended mode warns; on the VPS it is VPS_GITHUB_TOKEN.
GITHUB_TOKEN=
GITHUB_REPO=
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID_SEED=
NETLIFY_SITE_ID_PLATFORM=
# Read by the stripe-webhook function (as function secrets) and the Stripe scripts, never by the
# dispatcher.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Reserved, not read yet. The site reads VITE_STRIPE_PAYMENT_LINK_URL below.
STRIPE_PAYMENT_LINK_URL=
# The VPS jobs (docs/specs/money-safety.md, platform/ops/README.md, Backups and the Controller).
# make-jobs-env.sh copies each into the one job env file that needs it; provision.sh refuses all of
# them in the dispatcher's env file.
# The Controller's restricted Stripe key: rk_live_..., read-only, which cannot move money. Every job
# refuses a value starting sk_live_ or sk_test_ under any name.
STRIPE_READ_KEY=
# The backup: the Session pooler string for the read-only peanutgallery_backup login, the board's
# age public key (age1...), the bucket's write-only pre-authenticated request (ending in /o/) and the
# bucket's name. Every dump runs as that login; the owner's password never goes to the VPS.
BACKUP_DB_URL=
BACKUP_AGE_RECIPIENT=
BACKUP_PAR_URL=
BACKUP_BUCKET=
# Optional: 1 only if the backup login was refused the auth schema; the dump then leaves auth out.
BACKUP_SKIP_AUTH=
# Optional: the weekday of the backup's restore check, 1 (Monday) to 7 (Sunday, the default), in UTC.
RESTORE_CHECK_WEEKDAY=
# Optional: the quota check's lines. Defaults: 350 MB of database, and an alert when fewer than 400
# of 2,000 monthly Actions minutes are left.
DATABASE_ALERT_MB=
ACTIONS_MINUTES_INCLUDED=
ACTIONS_MINUTES_FLOOR=
# Read by the Supabase seed.
BOARD_EMAILS=
MODERATOR_EMAIL=
# Reserved, not read yet (the image adapter).
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
POOL_DAILY_CAP_USD=100
CARD_MAX_USD=25
SESSION_MAX_TURNS=60
# The longest one agent session may run, in minutes, before it is interrupted and its card paused.
SESSION_MAX_MINUTES=60
AGENT_HOURLY_RATE_USD=5
# Each role's spec in platform/agents names one of these tokens. The dispatcher resolves a role's
# model from them when a session starts, so a change here takes effect on the next dispatcher start;
# the Supabase seed writes the same values into roles.model, which /team shows, so re-seed the roles
# after a change. The board's values (docs/PLAN.md §10 decision 36): MODEL_BUILDER and MODEL_DIRECTOR
# are claude-opus-5-5, and MODEL_HOST is claude-haiku-4-5.
MODEL_BUILDER=
MODEL_DIRECTOR=
MODEL_HOST=
# USD per million tokens, keyed by model id, each row with the five rates input, output, cache_read,
# cache_write_5m and cache_write_1h. List every model a session can report, including the small fast
# model Claude Code calls on its own (for example claude-haiku-4-5); a missing one is metered at the
# table's highest rates and alerted. The claude-opus-5-5 row, at list price:
#   "claude-opus-5-5": {"input": 4, "output": 20, "cache_read": 0.2, "cache_write_5m": 5, "cache_write_1h": 8}
PRICE_TABLE_JSON=

# Site build-time values (public; set per Netlify site).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PAYMENT_LINK_URL=
VITE_DISCORD_INVITE=
# Where the site's Play link goes.
VITE_PLAY_URL=

# Dispatcher additions beyond Appendix A.
DISPATCHER_TICK_MS=60000
# Card worktrees; outside the repository clone, which the dispatcher refuses. Unset puts them beside
# the clone as <clone>-worktrees.
DISPATCHER_WORKTREE_ROOT=
DISPATCHER_MAX_CONCURRENCY=1
DISPATCHER_SCHEDULER=on
# Attended mode only: the Claude Code command line on the founder's Mac, 2.1.280 or newer (2.1.139
# refuses claude-opus-5-5). Unattended mode runs no CLI.
CLAUDE_BIN=claude
BOARD_SESSION_TTL_MIN=3
# Optional board alerts. The healthchecks.io ping URL is hit every tick; the ntfy topic URL gets a
# line when a card is rejected, pauses, is reverted, or the daily cap stops the agents. The
# stripe-webhook function also posts to NTFY_TOPIC_URL when it is set as a function secret.
HEALTHCHECK_URL=
NTFY_TOPIC_URL=

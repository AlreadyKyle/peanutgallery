{
  "name": "@backseat/seed-1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "tsx e2e/frame-states.ts node_modules/.cache/frame-states.json && E2E_FRAME_STATES=node_modules/.cache/frame-states.json playwright test",
    "bot": "tsx bots/cli.ts",
    "capture": "tsx scripts/capture.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}

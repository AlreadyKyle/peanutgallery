# systemd unit for the Peanut Gallery dispatcher container on the VPS (docs/specs/vps.md).
# provision.sh and deploy.sh install it at /etc/systemd/system/dispatcher.service. provision.sh
# enables it and never starts it: starting it is the cutover (README.md).
#
# The container runs as uid 10001 (docs/specs/ops-separation.md). It runs the dispatcher from the
# root-owned code clone, mounted read-only at /opt/peanutgallery, and the dispatcher refuses to start
# (exit 78) when it can write there. It fetches, pushes and adds worktrees in the work clone at
# /srv/peanutgallery and the worktree folder at /srv/peanutgallery-worktrees, both owned by uid 10001
# and mounted read-write. Secrets come only from docker's --env-file. There is no EnvironmentFile= here: systemd strips quotes and would
# corrupt PRICE_TABLE_JSON. --pull never keeps docker from fetching a same-named image from a
# registry.
#
# Restarts: after 30 seconds, growing over 6 steps to 30 minutes, at most 8 starts in 6 hours.
# Exit 78 is a startup failure no restart can fix and is never restarted. Either way the unit ends
# failed and OnFailure= starts dispatcher-alert.service.
[Unit]
Description=Peanut Gallery dispatcher
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
StartLimitIntervalSec=6h
StartLimitBurst=8
OnFailure=dispatcher-alert.service

[Service]
Restart=always
RestartSec=30s
RestartSteps=6
RestartMaxDelaySec=30min
RestartPreventExitStatus=78
TimeoutStopSec=90s
ExecStartPre=-/usr/bin/docker rm -f peanutgallery-dispatcher
ExecStart=/usr/bin/docker run --rm --name peanutgallery-dispatcher \
  --pull never \
  --env-file /etc/peanutgallery/dispatcher.env \
  --user 10001:10001 \
  --volume /srv/peanutgallery-code:/opt/peanutgallery:ro \
  --volume /srv/peanutgallery:/srv/peanutgallery \
  --volume /srv/peanutgallery-worktrees:/srv/peanutgallery-worktrees \
  --env DISPATCHER_CODE_ROOT=/opt/peanutgallery \
  --env DISPATCHER_REPO_ROOT=/srv/peanutgallery \
  --env DISPATCHER_WORKTREE_ROOT=/srv/peanutgallery-worktrees \
  --env DISPATCHER_CODE_READONLY=required \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --memory 3g \
  --pids-limit 512 \
  --log-opt max-size=10m \
  peanutgallery/dispatcher:current
ExecStop=-/usr/bin/docker stop -t 60 peanutgallery-dispatcher

[Install]
WantedBy=multi-user.target

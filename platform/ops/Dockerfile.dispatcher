# Dispatcher image for the VPS (docs/specs/vps.md, docs/specs/ops-separation.md,
# docs/specs/launch-managed.md): the toolchain only. The repository is not copied in.
# dispatcher.service mounts three host folders:
#   /srv/peanutgallery-code       at /opt/peanutgallery, read-only: the root-owned code clone the
#                                 dispatcher and its node_modules run from
#   /srv/peanutgallery            at the same path: the work clone uid 10001 fetches and pushes in
#   /srv/peanutgallery-worktrees  at the same path: card worktrees
# Worktree metadata lives in the work clone's .git, so it survives restarts.
#
# No agent runs here. Unattended cards run as Claude Managed Agents sessions in containers Anthropic
# hosts; the dispatcher keeps their event streams, applies each accepted patch with git and drives the
# gate, merge and deploy. So the image carries no claude CLI, no sandbox tools and no Claude Code
# settings, and no agent-written code runs beside the dispatcher's secrets.
#
# Built on the VPS from a commit, never from a working tree (provision.sh and deploy.sh):
#   git archive <sha>:platform/ops | docker build -f Dockerfile.dispatcher \
#     -t peanutgallery/dispatcher:<sha> -t peanutgallery/dispatcher:current -
# Dockerfile.dispatcher.dockerignore admits only the entrypoint. Secrets never enter the image: they
# reach the container through docker's --env-file at run time.
#
# To pin the base image by digest, pass --build-arg NODE_IMAGE=node:22-bookworm-slim@sha256:<digest>
# (NODE_IMAGE=... for provision.sh and deploy.sh; see README.md).
ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE}

# The root package.json's packageManager.
ARG PNPM_VERSION=11.0.9

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates tini \
  && rm -rf /var/lib/apt/lists/*

# npm, not corepack: corepack caches pnpm under root's home, which uid 10001 cannot read. pnpm is for
# deploy.sh's and provision.sh's throwaway install of the dispatcher's node_modules.
RUN npm install -g "pnpm@${PNPM_VERSION}" \
  && npm cache clean --force

RUN groupadd --gid 10001 agent \
  && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash agent

# The build uid for deploy.sh's and provision.sh's throwaway pnpm install: it owns only node_modules
# and the store while the install runs, never the code clone's tracked files or .git.
RUN groupadd --gid 10002 build \
  && useradd --uid 10002 --gid 10002 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin build

COPY --chmod=0755 dispatcher-entrypoint.sh /usr/local/bin/dispatcher-entrypoint.sh

USER 10001:10001
RUN git config --global user.name "Mob Machine agents" \
  && git config --global user.email agents@peanutgallery.games

# pnpm 11 reads its store location from pnpm_config_store_dir (it ignores npm_config_store_dir). Only
# deploy.sh's throwaway install container runs pnpm install, into the code clone, so the store sits
# there and hard-links into node_modules on the same mount. No NODE_ENV=production: it would drop
# devDependencies such as tsx.
ENV CI=true \
    pnpm_config_store_dir=/opt/peanutgallery/.pnpm-store

WORKDIR /opt/peanutgallery
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/dispatcher-entrypoint.sh"]

# Dispatcher image: Node 22, pnpm from the workspace's packageManager field, git for worktrees.
# Build from the repository root with BuildKit (the default in Docker 23 and later):
#   docker build -f platform/ops/Dockerfile.dispatcher -t backseat/dispatcher:latest .
# BuildKit filters the build context with Dockerfile.dispatcher.dockerignore beside this file,
# so .env, KEYS.md, worktrees, node_modules and build output never enter the image. Secrets
# reach the container only through the systemd unit's environment file.
# Written for the week-2 VPS; not deployed in build 1.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.0.9 --activate

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile

ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@backseat/dispatcher", "start"]

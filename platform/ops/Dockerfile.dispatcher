# Dispatcher image for the VPS (docs/specs/vps.md): the toolchain only. The repository is not
# copied in. dispatcher.service bind-mounts the host clone at /srv/peanutgallery, the same path
# inside and out, so git worktree metadata in the clone's .git survives restarts and an update is
# a fast-forward plus a restart.
#
# Built on the VPS from the clone with platform/ops as the context (provision.sh and deploy.sh):
#   docker build -f platform/ops/Dockerfile.dispatcher \
#     -t peanutgallery/dispatcher:<sha> -t peanutgallery/dispatcher:current platform/ops
# Dockerfile.dispatcher.dockerignore admits only the entrypoint into the context. Secrets never
# enter the image: they reach the container through docker's --env-file at run time.
#
# To pin the base image by digest, pass --build-arg NODE_IMAGE=node:22-bookworm-slim@sha256:<digest>
# (NODE_IMAGE=... for provision.sh and deploy.sh; see README.md).
ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE}

# The claude CLI version on the board's Mac and in platform/dispatcher/test/fixtures/probe.jsonl
# (claude_code_version). The entrypoint refuses to start any other.
ARG CLAUDE_CODE_VERSION=2.1.139
# The root package.json's packageManager.
ARG PNPM_VERSION=11.0.9

# bookworm, not alpine: the claude CLI's bundled ripgrep is linked against glibc.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates tini \
  && rm -rf /var/lib/apt/lists/*

# npm, not corepack: corepack caches pnpm under root's home, which uid 10001 cannot read.
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" "pnpm@${PNPM_VERSION}" \
  && npm cache clean --force

RUN groupadd --gid 10001 agent \
  && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash agent

COPY --chmod=0755 dispatcher-entrypoint.sh /usr/local/bin/dispatcher-entrypoint.sh

USER 10001:10001
RUN git config --global user.name "Peanut Gallery agents" \
  && git config --global user.email agents@peanutgallery.games

# CLAUDE_CODE_VERSION stays in the environment for the entrypoint's check. pnpm 11 reads its store
# location from pnpm_config_store_dir (it ignores npm_config_store_dir); the store sits on the bind
# mount so it survives the --rm container and hard-links into node_modules on the same filesystem.
# No NODE_ENV=production: it would drop devDependencies such as tsx. Agent sessions and the smoke
# bot get none of these: the dispatcher builds their environment from an allowlist, and its
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC switch turns the updater off inside sessions.
ENV CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION} \
    CLAUDE_BIN=/usr/local/bin/claude \
    DISABLE_AUTOUPDATER=1 \
    CI=true \
    pnpm_config_store_dir=/srv/peanutgallery/.pnpm-store

WORKDIR /srv/peanutgallery
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/dispatcher-entrypoint.sh"]

# The quota check (docs/specs/money-safety.md): the database's size and this month's Actions minutes,
# alerting the board through ntfy before a free-tier limit trips. It runs platform/ops/jobs/main.mjs
# from the read-only code clone in the dispatcher image, as nobody, with a read-only root and no
# capability; its secrets come only from /etc/peanutgallery/quota.env. Started by
# peanutgallery-quota.timer.
[Unit]
Description=Peanut Gallery quota check
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionPathExists=/etc/peanutgallery/quota.env
OnFailure=peanutgallery-job-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=10min
ExecStartPre=-/usr/bin/docker rm -f peanutgallery-quota
ExecStart=/usr/bin/docker run --rm --name peanutgallery-quota \
  --pull never \
  --env-file /etc/peanutgallery/quota.env \
  --user 65534:65534 \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --memory 256m \
  --pids-limit 64 \
  --log-opt max-size=10m \
  --volume /srv/peanutgallery-code:/opt/peanutgallery:ro \
  --entrypoint node \
  peanutgallery/dispatcher:current \
  /opt/peanutgallery/platform/ops/jobs/main.mjs quota

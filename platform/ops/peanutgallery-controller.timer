# Runs peanutgallery-controller.service once a day, after the backup (docs/specs/money-safety.md).
# Persistent= makes up a missed run at the next boot.
[Unit]
Description=Peanut Gallery Controller: the daily reconciliation with Stripe

[Timer]
OnCalendar=*-*-* 07:07:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target

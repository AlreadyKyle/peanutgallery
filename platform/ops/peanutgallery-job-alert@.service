# Oneshot started by a Mob Machine job's OnFailure= (docs/specs/money-safety.md): the backup, the
# Controller or the quota check could not run, or the backup failed. %i is the failed unit. It posts
# one line to the ntfy topic URL in /etc/peanutgallery/ntfy.url and does nothing when that file is
# absent. It reads no other file and needs no secret.
# provision.sh and deploy.sh install it at /etc/systemd/system/peanutgallery-job-alert@.service.
[Unit]
Description=Tell the board a Mob Machine job failed (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'f=/etc/peanutgallery/ntfy.url; [ -s "$$f" ] || exit 0; exec /usr/bin/curl -fsS --max-time 20 -H "Title: Mob Machine job" --data-binary "Mob Machine job %i failed on %H; journalctl -u %i shows why" "$$(head -n 1 "$$f" | tr -d "[:space:]")"'

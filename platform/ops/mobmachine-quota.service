# The quota check (docs/specs/money-safety.md): the database's size and this month's Actions minutes,
# alerting the board through ntfy before a free-tier limit trips. It runs platform/ops/jobs/main.mjs
# from the read-only code clone in the dispatcher image, as nobody, with a read-only root and no
# capability; its secrets come only from /etc/mobmachine/quota.env. Started by
# mobmachine-quota.timer.
[Unit]
Description=Mob Machine quota check
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionPathExists=/etc/mobmachine/quota.env
OnFailure=mobmachine-job-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=10min
ExecStartPre=-/usr/bin/docker rm -f mobmachine-quota
ExecStart=/usr/bin/docker run --rm --name mobmachine-quota \
  --pull never \
  --env-file /etc/mobmachine/quota.env \
  --user 65534:65534 \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --memory 256m \
  --pids-limit 64 \
  --log-opt max-size=10m \
  --volume /srv/mobmachine-code:/opt/mobmachine:ro \
  --entrypoint node \
  peanutgallery/dispatcher:current \
  /opt/mobmachine/platform/ops/jobs/main.mjs quota

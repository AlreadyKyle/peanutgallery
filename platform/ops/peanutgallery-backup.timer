# Runs peanutgallery-backup.service once a day (docs/specs/money-safety.md). Persistent= runs a missed
# backup at the next boot, so a day the instance was stopped is made up.
[Unit]
Description=Peanut Gallery nightly database backup

[Timer]
OnCalendar=*-*-* 06:17:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target

# The Controller (docs/specs/money-safety.md): the daily reconciliation of the books against Stripe,
# outside the dispatcher. It runs platform/ops/jobs/main.mjs from the read-only code clone in the
# dispatcher image, as nobody, with a read-only root and no capability. Its secrets come only from
# /etc/peanutgallery/controller.env: the Supabase service key and the restricted Stripe read key, which
# can read and cannot move money. A mismatch alerts the board through ntfy from the job itself;
# OnFailure= posts when the job could not run at all. Started by peanutgallery-controller.timer.
[Unit]
Description=Peanut Gallery Controller: the daily reconciliation with Stripe
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionPathExists=/etc/peanutgallery/controller.env
OnFailure=peanutgallery-job-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=30min
ExecStartPre=-/usr/bin/docker rm -f peanutgallery-controller
ExecStart=/usr/bin/docker run --rm --name peanutgallery-controller \
  --pull never \
  --env-file /etc/peanutgallery/controller.env \
  --user 65534:65534 \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --memory 256m \
  --pids-limit 64 \
  --log-opt max-size=10m \
  --volume /srv/peanutgallery-code:/opt/peanutgallery:ro \
  --entrypoint node \
  peanutgallery/dispatcher:current \
  /opt/peanutgallery/platform/ops/jobs/main.mjs controller
